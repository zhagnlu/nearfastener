{
  "name": "nearfastener-replica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run export:static && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "export:static": "node scripts/export-static.mjs",
    "i18n:build": "node scripts/build-locales.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:flow": "npm run export:static && node --test tests/catalog.test.mjs tests/i18n.test.mjs tests/screw-flow.test.mjs tests/resources.test.mjs",
    "prebuild": "npm run catalog:build && npm run resources:build && npm run i18n:build && npm run seo:build",
    "predev": "npm run catalog:build && npm run resources:build && npm run i18n:build && npm run seo:build",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "resources:build": "node scripts/build-resources.mjs",
    "seo:build": "node scripts/build-seo.mjs",
    "publish:ecs": "node scripts/publish-ecs.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
